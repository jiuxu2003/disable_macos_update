    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadIdentifier</key>
    <string>local.disable-macos-update.delayed-major.profile</string>
    <key>PayloadUUID</key>
    <string>BC365842-B6F4-4901-8561-AC8D96A9CB24</string>
    <key>PayloadVersion</key>
    <integer>1</integer>
    <key>PayloadDisplayName</key>
    <string>Delay major macOS updates (90 days)</string>
    <key>PayloadDescription</key>
    <string>把大版本 macOS 升级推迟 90 天，减少升级提醒与系统设置红点。移除本描述文件即可恢复原有行为。</string>
    <key>PayloadOrganization</key>
    <string>disable_macos_update</string>
    <key>PayloadRemovalDisallowed</key>
