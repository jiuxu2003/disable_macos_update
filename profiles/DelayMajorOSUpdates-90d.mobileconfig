<dict>
    <key>PayloadContent</key>
    <array>
        <dict>
            <key>PayloadType</key>
            <string>com.apple.applicationaccess</string>
            <key>PayloadIdentifier</key>
            <string>local.disable-macos-update.delayed-major</string>
            <key>PayloadUUID</key>
            <string>AD7F8D80-32F4-4D90-B797-C761F3E3EB84</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadDisplayName</key>
            <string>Delay major macOS updates</string>
            <key>PayloadDescription</key>
            <string>隐藏大版本 macOS 升级（如 macOS 26/27）90 天，小版本与安全补丁不受影响。</string>
            <key>PayloadOrganization</key>
            <string>disable_macos_update</string>
            <key>forceDelayedMajorSoftwareUpdates</key>
            <true/>
